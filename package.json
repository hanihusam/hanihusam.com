    "clsx": "^2.1.1",
    "compression": "^1.7.5",
    "cookie": "^1.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "esbuild": "^0.28.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.9.3",
    "gsap": "^3.15.0",
    "isbot": "^5.1.22",
    "lru-cache": "^11.0.2",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdx-bundler": "^10.0.3",
    "morgan": "^1.10.0",
    "motion": "^12.38.0",
    "p-queue": "^9.3.0",
    "prisma": "^6.19.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.0.1",
    "reading-time": "^1.5.0",
